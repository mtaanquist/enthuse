// Home screen (docs/ui.md, "Home"): continue watching and the sources.
// Rust fills HomeModel for each window; the screen only displays it.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, KeyFocus } from "theme.slint";
import { ButtonVariant, IconButton, PillButton } from "components/buttons.slint";
import { ButtonBehavior, FocusGrid } from "components/behavior.slint";
import { TipText } from "components/tip-text.slint";

export struct ContinueItem {
    title: string,
    // "S02E05, 31 min left"
    subtitle: string,
    // How far along (0..1).
    progress: float,
    // A frame grab (#68); empty until there is one.
    thumbnail: image,
}

export enum SourceIcon { drive, server, library, folder }

export struct SourceTileItem {
    name: string,
    // Path or address.
    detail: string,
    // "Local", "SMB", later "Plex" or "Jellyfin". "Offline" when unreachable.
    kind-label: string,
    icon: SourceIcon,
    offline: bool,
    // A library listed first (#59).
    favorite: bool,
    // A tile in the Favourites row: its menu only unstars it.
    folder: bool,
}

export global HomeModel {
    in property <[ContinueItem]> continue-items;
    in property <[SourceTileItem]> sources;
    // Favourite folders inside libraries.
    in property <[SourceTileItem]> favorites;
    // False until the sources are known, so first run doesn't flash.
    in property <bool> loaded;

    callback play(int);
    callback open-source(int);
    callback toggle-favorite(int);
    callback open-favorite(int);
    callback remove-favorite(int);
    // Show the Libraries page, where libraries are arranged.
    callback show-libraries();
    // Asks Rust to load the lists again, e.g. when Home shows.
    callback refresh();
}

component SectionHeading inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.section-size;
    font-weight: Theme.section-weight;
    vertical-alignment: center;
}

component ContinueCard inherits Rectangle {
    in property <ContinueItem> item;
    callback clicked();
    // See ButtonBehavior.arrow.
    callback arrow(string) -> bool;

    forward-focus: behavior;
    accessible-role: button;
    accessible-label: root.item.title + ", " + root.item.subtitle;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: Theme.space-8;

        Rectangle {
            height: self.width * 9 / 16;
            border-radius: Theme.radius-medium;
            background: behavior.has-hover ? Theme.line-strong : Theme.surface-raised;
            clip: true;

            animate background {
                duration: Theme.hover-duration;
            }

            if root.item.thumbnail.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.thumbnail;
                image-fit: cover;
            }

            if root.item.thumbnail.width == 0: Image {
                width: Theme.icon-size-large + 6px;
                height: self.width;
                source: Icons.video;
                colorize: Theme.text-faint;
            }

            Rectangle {
                x: Theme.space-16;
                y: parent.height - self.height - Theme.space-16;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.overlay-card;

                Image {
                    x: 12px;
                    width: 14px;
                    height: 14px;
                    source: Icons.play;
                    colorize: Theme.text;
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 4px;
                background: Theme.track;

                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.item.progress, 0, 1);
                    background: Theme.accent;
                }
            }
        }

        VerticalLayout {
            spacing: 2px;

            TipText {
                text: root.item.title;
                hovered: behavior.has-hover;
                font-size: Theme.body-size;
                font-weight: Theme.body-strong-weight;
            }

            Text {
                text: root.item.subtitle;
                color: Theme.text-muted;
                font-size: Theme.label-size;
                overflow: elide;
            }
        }
    }

    behavior := ButtonBehavior {
        ring-radius: Theme.radius-medium;
        clicked => { root.clicked(); }
        arrow(k) => { return root.arrow(k); }
    }
}

// One row of a tile's menu.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger;
    callback clicked();

    height: Theme.touch-target;
    border-radius: Theme.radius-small;
    background: item-behavior.has-hover ? Theme.line-strong : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-12;

        Image {
            width: Theme.icon-size;
            source: root.icon;
            colorize: root.danger ? Theme.danger : Theme.text-muted;
            image-fit: contain;
        }

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.label-size;
            vertical-alignment: center;
        }
    }

    item-behavior := ButtonBehavior {
        ring-radius: Theme.radius-small;
        clicked => { root.clicked(); }
    }
}

component SourceTile inherits Rectangle {
    in property <SourceTileItem> item;
    callback clicked();
    // From the Favourites row: unstar it.
    callback remove();
    callback toggle-favorite();
    // Open Settings, where libraries are arranged.
    callback manage();
    callback arrow(string) -> bool;
    // Bottom of the visible area, in window coordinates. Popups that would
    // not fit below the tile open above it.
    in property <length> viewport-bottom: 1000000px;


    // Fits "Remove from favourites" with its icon.
    property <length> menu-width: 264px;
    property <int> menu-items: root.item.folder ? 1 : 2;
    property <length> menu-height: root.menu-items * Theme.touch-target + 2 * Theme.space-4 + 2px;
    property <bool> menu-up: root.absolute-position.y + more.y + more.height + Theme.space-4 + root.menu-height > root.viewport-bottom - Theme.space-16;


    height: 84px;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.line;
    background: behavior.pressed ? Theme.pressed(Theme.surface) : behavior.has-hover ? Theme.surface-raised : Theme.surface;
    forward-focus: behavior;
    accessible-role: button;
    accessible-label: root.item.name + ", " + root.item.kind-label;
    accessible-action-default => { root.clicked(); }

    animate background {
        duration: behavior.pressed ? 0ms : Theme.hover-duration;
    }

    HorizontalLayout {
        padding-left: Theme.space-20;
        padding-right: Theme.space-8;
        spacing: Theme.space-16;
        opacity: root.item.offline ? 0.5 : 1;

        Rectangle {
            width: Theme.touch-target;
            height: Theme.touch-target;
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-medium;
            background: Theme.surface-raised;

            Image {
                width: Theme.icon-size;
                height: Theme.icon-size;
                source: root.item.icon == SourceIcon.server ? Icons.server : root.item.icon == SourceIcon.library ? Icons.library : root.item.icon == SourceIcon.folder ? Icons.folder : Icons.drive;
                colorize: Theme.accent;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            name := TipText {
                text: root.item.name;
                hovered: behavior.has-hover;
                font-size: Theme.body-size;
                font-weight: Theme.body-strong-weight;
            }

            // Long paths: the full one in the tooltip, unless the name is
            // cut too (one tip at a time).
            TipText {
                text: root.item.detail;
                hovered: behavior.has-hover && !name.cut;
                text-color: Theme.text-muted;
                font-size: Theme.label-size;
            }
        }

        if root.item.favorite: Image {
            width: Theme.icon-size;
            height: Theme.icon-size;
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            source: Icons.star-filled;
            colorize: Theme.accent;
            accessible-role: image;
            accessible-label: "Favourite";
        }

        if !root.item.folder: Rectangle {
            width: chip-text.preferred-width + 2 * Theme.space-12;
            height: 28px;
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: root.item.offline ? Theme.line-strong : Theme.surface-raised;

            chip-text := Text {
                text: root.item.kind-label;
                color: root.item.offline ? Theme.danger : Theme.text-muted;
                font-size: Theme.chip-size;
                font-weight: Theme.chip-weight;
            }
        }

        // Room for the menu button, which sits on top of the tile.
        Rectangle {
            width: Theme.touch-target;
            horizontal-stretch: 0;
        }
    }

    behavior := ButtonBehavior {
        ring-radius: Theme.radius-large;
        clicked => { root.clicked(); }
        arrow(k) => { return root.arrow(k); }
    }

    more := IconButton {
        x: parent.width - self.width - Theme.space-8;
        y: (parent.height - self.height) / 2;
        variant: ButtonVariant.outline;
        border-width: 0px;
        icon: Icons.more;
        label: "More for " + root.item.name;
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        x: more.x + more.width - root.menu-width;
        y: root.menu-up ? more.y - Theme.space-4 - root.menu-height : more.y + more.height + Theme.space-4;
        width: root.menu-width;

        Rectangle {
            border-radius: Theme.radius-medium;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);

            VerticalLayout {
                padding: Theme.space-4;

                if !root.item.folder: MenuItem {
                    text: root.item.favorite ? "Remove from favourites" : "Add to favourites";
                    icon: root.item.favorite ? Icons.star-filled : Icons.star;
                    clicked => {
                        // Before closing: closing drops the rest of this handler.
                        root.toggle-favorite();
                        menu.close();
                    }
                }

                if !root.item.folder: MenuItem {
                    text: "Manage libraries…";
                    icon: Icons.settings;
                    clicked => {
                        root.manage();
                        menu.close();
                    }
                }

                if root.item.folder: MenuItem {
                    text: "Remove from favourites";
                    icon: Icons.close;
                    danger: true;
                    clicked => {
                        root.remove();
                        menu.close();
                    }
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    callback open-source(int);
    callback open-favorite(int);
    // Libraries are arranged in Settings.
    callback manage-libraries();

    // Arrow keys move within the cards and within the tiles; Up from the
    // tiles goes to the cards and Down from the cards to the tiles. The
    // item to focus is asked for by bumping the serial.
    property <int> focus-group; // 0 cards, 1 tiles, 2 favourites
    property <int> focus-target: -1;
    property <int> focus-serial;
    property <int> first-serial: KeyFocus.first-serial;
    changed first-serial => {
        root.move-to(HomeModel.continue-items.length > 0 ? 0 : 1, 0);
    }

    function move-to(group: int, target: int) {
        if (target < 0) {
            return;
        }
        root.focus-group = group;
        root.focus-target = target;
        root.focus-serial += 1;
    }

    // Scrolls so an item `top` from the top of the visible area (negative
    // when above it) and `h` tall is fully in view.
    function reveal(top: length, h: length) {
        if (top < 0) {
            scroll.content-y = min(0px, scroll.content-y - top + Theme.space-16);
        } else if (top + h > scroll.visible-height) {
            scroll.content-y = scroll.content-y - (top + h - scroll.visible-height) - Theme.space-16;
        }
    }

    property <length> pad: root.width < 700px ? Theme.space-24 : Theme.content-padding-x;
    property <length> gap: Theme.space-24;



    scroll := ScrollView {
        property <length> inner: self.visible-width - 2 * root.pad;
        // Continue watching: 4 cards, 3 or 2 when there is less room.
        property <int> card-columns: self.inner >= 720px ? 4 : self.inner >= 520px ? 3 : 2;
        property <length> card-width: (self.inner - (self.card-columns - 1) * root.gap) / self.card-columns;
        property <int> card-count: min(HomeModel.continue-items.length, self.card-columns);
        // Sources: 3 per row, 2 or 1 when there is less room.
        property <int> tile-columns: self.inner >= 900px ? 3 : self.inner >= 480px ? 2 : 1;
        property <length> tile-width: (self.inner - (self.tile-columns - 1) * root.gap) / self.tile-columns;

        content-width: self.visible-width;
        content-height: page.preferred-height;

        page := VerticalLayout {
            x: 0;
            width: parent.visible-width;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: Theme.content-padding-top;
            padding-bottom: Theme.space-48;
            spacing: Theme.space-36;

            Text {
                text: "Home";
                color: Theme.text;
                font-size: Theme.title-size;
                font-weight: Theme.title-weight;
                letter-spacing: Theme.title-letter-spacing;
            }

            if HomeModel.continue-items.length > 0: VerticalLayout {
                spacing: Theme.space-16;

                SectionHeading {
                    text: "Continue watching";
                }

                Rectangle {
                    height: scroll.card-width * 9 / 16 + 56px;

                    for item[index] in HomeModel.continue-items: ContinueCard {
                        property <int> serial: root.focus-serial;
                        changed serial => {
                            if (root.focus-group == 0 && index == root.focus-target) {
                                root.reveal(self.absolute-position.y - scroll.absolute-position.y, self.height);
                                self.focus();
                            }
                        }
                        arrow(k) => {
                            if (k == Key.DownArrow && HomeModel.favorites.length > 0) {
                                root.move-to(2, 0);
                            } else if (k == Key.DownArrow && HomeModel.sources.length > 0) {
                                root.move-to(1, 0);
                            } else {
                                root.move-to(0, FocusGrid.target(index, scroll.card-count, scroll.card-count, k));
                            }
                            return true;
                        }
                        x: index * (scroll.card-width + root.gap);
                        width: scroll.card-width;
                        visible: index < scroll.card-count;
                        item: item;
                        clicked => { HomeModel.play(index); }
                    }
                }
            }

            if HomeModel.loaded && HomeModel.favorites.length > 0: VerticalLayout {
                spacing: Theme.space-16;

                SectionHeading {
                    text: "Favourites";
                }

                Rectangle {
                    property <int> rows: ceil(HomeModel.favorites.length / scroll.tile-columns);
                    height: self.rows * 84px + max(0, self.rows - 1) * root.gap;

                    for tile[index] in HomeModel.favorites: SourceTile {
                        property <int> serial: root.focus-serial;
                        changed serial => {
                            if (root.focus-group == 2 && index == root.focus-target) {
                                root.reveal(self.absolute-position.y - scroll.absolute-position.y, self.height);
                                self.focus();
                            }
                        }
                        arrow(k) => {
                            if (k == Key.UpArrow && index < scroll.tile-columns && HomeModel.continue-items.length > 0) {
                                root.move-to(0, 0);
                            } else if (k == Key.DownArrow && index + scroll.tile-columns >= HomeModel.favorites.length && HomeModel.sources.length > 0) {
                                root.move-to(1, 0);
                            } else {
                                root.move-to(2, FocusGrid.target(index, HomeModel.favorites.length, scroll.tile-columns, k));
                            }
                            return true;
                        }
                        x: mod(index, scroll.tile-columns) * (scroll.tile-width + root.gap);
                        y: floor(index / scroll.tile-columns) * (84px + root.gap);
                        width: scroll.tile-width;
                        viewport-bottom: scroll.absolute-position.y + scroll.visible-height;
                        item: tile;
                        clicked => { root.open-favorite(index); }
                        remove => { HomeModel.remove-favorite(index); }
                    }
                }
            }

            if HomeModel.loaded && HomeModel.sources.length > 0: VerticalLayout {
                spacing: Theme.space-16;

                HorizontalLayout {
                    spacing: Theme.space-12;

                    SectionHeading {
                        text: "Libraries";
                    }

                    PillButton {
                        icon: Icons.settings;
                        text: "Manage";
                        clicked => { root.manage-libraries(); }
                    }

                }

                Rectangle {
                    property <int> rows: ceil(HomeModel.sources.length / scroll.tile-columns);
                    height: self.rows * 84px + max(0, self.rows - 1) * root.gap;

                    for tile[index] in HomeModel.sources: SourceTile {
                        property <int> serial: root.focus-serial;
                        changed serial => {
                            if (root.focus-group == 1 && index == root.focus-target) {
                                root.reveal(self.absolute-position.y - scroll.absolute-position.y, self.height);
                                self.focus();
                            }
                        }
                        arrow(k) => {
                            if (k == Key.UpArrow && index < scroll.tile-columns && HomeModel.favorites.length > 0) {
                                root.move-to(2, 0);
                            } else if (k == Key.UpArrow && index < scroll.tile-columns && HomeModel.continue-items.length > 0) {
                                root.move-to(0, 0);
                            } else {
                                root.move-to(1, FocusGrid.target(index, HomeModel.sources.length, scroll.tile-columns, k));
                            }
                            return true;
                        }
                        x: mod(index, scroll.tile-columns) * (scroll.tile-width + root.gap);
                        y: floor(index / scroll.tile-columns) * (84px + root.gap);
                        width: scroll.tile-width;
                        viewport-bottom: scroll.absolute-position.y + scroll.visible-height;
                        item: tile;
                        clicked => { root.open-source(index); }
                        toggle-favorite => { HomeModel.toggle-favorite(index); }
                        manage => { root.manage-libraries(); }
                    }
                }
            }

            // First run: one large prompt in place of the sources grid.
            if HomeModel.loaded && HomeModel.sources.length == 0: Rectangle {
                height: 240px;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.surface;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-20;

                    Text {
                        text: "Add a folder or network share under Libraries to get started";
                        color: Theme.text;
                        font-size: Theme.section-size;
                        font-weight: Theme.section-weight;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;

                        PillButton {
                            size: 48px;
                            variant: ButtonVariant.primary;
                            icon: Icons.library;
                            text: "Open Libraries";
                            clicked => { root.manage-libraries(); }
                        }
                    }
                }
            }
        }
    }
}
