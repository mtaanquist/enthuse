// Render spike (#17): video drawn by mpv underneath, one Slint button on top.

export component SpikeWindow inherits Window {
    title: "Enthuse";
    preferred-width: 640px;
    preferred-height: 480px;
    // Transparent so the video drawn in the BeforeRendering notifier shows.
    background: transparent;

    in property <bool> paused;
    callback toggle-pause();

    // Fixed position and color so the self-test can find it in a snapshot.
    button := Rectangle {
        x: parent.width - 100px;
        y: parent.height - 80px;
        width: 80px;
        height: 60px;
        border-radius: 8px;
        background: touch.pressed ? #c00060 : #ff0080;

        Text {
            text: root.paused ? "Play" : "Pause";
            color: white;
            font-size: 16px;
        }

        touch := TouchArea {
            clicked => { root.toggle-pause(); }
        }
    }
}
