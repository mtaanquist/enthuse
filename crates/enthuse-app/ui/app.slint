// Enthuse main window. The screens still have the prototype layout; they
// move to the design in docs/ui.md issue by issue (milestone M2).

import { ListView, LineEdit } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { ButtonVariant, IconButton, PillButton } from "components/buttons.slint";
//
// The window background is transparent so the video, drawn underneath by
// mpv, shows through. Pages that are not the player draw their own
// opaque background.

export struct TrackItem {
    id: int,
    label: string,
    selected: bool,
}

// A row in the folder browser.
export struct BrowserItem {
    label: string,
    detail: string,
    // 0 = source, 1 = folder, 2 = video.
    kind: int,
    // Videos: how far along an in-progress file is (0..1), or -1.
    progress: float,
    watched: bool,
}

// Fixed geometry the self-test relies on (see src/selftest.rs).
export global Layout {
    out property <length> bar-height: 96px;
    out property <length> button-size: Theme.transport-button-size;
    out property <length> gutter: Theme.space-16;
}

// Seek bar: tap or drag anywhere to seek. Large hit area for touch.
component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    callback seek(float);

    height: 40px;

    property <float> fraction: duration > 0 ? clamp(position / duration, 0, 1) : 0;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;

        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: track.width * root.fraction - self.width / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.on-video;
    }

    touch := TouchArea {
        function seek-to(x: length) {
            if (root.duration > 0) {
                root.seek(clamp(x / self.width, 0, 1) * root.duration);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.seek-to(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.seek-to(self.mouse-x);
            }
        }
    }
}

component PlayerPage inherits Rectangle {
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <string> title;
    in property <string> message;
    in property <[TrackItem]> subtitle-tracks;
    callback toggle-pause();
    callback seek(float);
    callback select-subtitle(int);
    callback back();
    callback toggle-pip();

    property <bool> show-subtitles;

    // Top bar: back and title.
    Rectangle {
        x: 0;
        y: 0;
        height: Layout.button-size + 2 * Layout.gutter;
        background: Theme.scrim-top;

        IconButton {
            x: Layout.gutter;
            y: Layout.gutter;
            variant: ButtonVariant.overlay;
            icon: Icons.back;
            label: "Back";
            clicked => { root.back(); }
        }

        Text {
            x: Layout.gutter * 2 + Layout.button-size;
            width: parent.width - self.x - Layout.gutter;
            text: root.title;
            color: Theme.text;
            font-size: Theme.section-size;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    if root.message != "": Rectangle {
        width: min(parent.width - 2 * Layout.gutter, 520px);
        height: 72px;
        border-radius: 12px;
        background: Theme.overlay-card;

        Text {
            width: parent.width - 2 * Layout.gutter;
            text: root.message;
            color: Theme.text;
            font-size: Theme.body-size;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Bottom bar: play/pause, seek, time, subtitles.
    Rectangle {
        x: 0;
        y: parent.height - Layout.bar-height;
        height: Layout.bar-height;
        background: Theme.overlay-card;

        play := IconButton {
            x: Layout.gutter;
            y: (parent.height - self.height) / 2;
            size: Layout.button-size;
            variant: ButtonVariant.primary;
            icon: root.paused ? Icons.play : Icons.pause;
            label: root.paused ? "Play" : "Pause";
            clicked => { root.toggle-pause(); }
        }

        subs := IconButton {
            x: parent.width - self.width - Layout.gutter;
            y: (parent.height - self.height) / 2;
            variant: ButtonVariant.overlay;
            icon: Icons.subtitles;
            label: "Subtitles";
            clicked => { root.show-subtitles = !root.show-subtitles; }
        }

        pip := IconButton {
            x: subs.x - self.width - Layout.gutter;
            y: (parent.height - self.height) / 2;
            variant: ButtonVariant.overlay;
            icon: Icons.pip;
            label: "Picture in picture";
            clicked => { root.toggle-pip(); }
        }

        time := Text {
            x: pip.x - self.width - Layout.gutter;
            width: 130px;
            text: root.position-text + " / " + root.duration-text;
            color: Theme.text-muted;
            font-size: Theme.meta-size;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        SeekBar {
            x: play.x + play.width + Layout.gutter;
            width: time.x - self.x - Layout.gutter;
            y: (parent.height - self.height) / 2;
            position: root.position;
            duration: root.duration;
            seek(t) => { root.seek(t); }
        }
    }

    // Subtitle picker, above the bottom bar on the right.
    if root.show-subtitles: Rectangle {
        width: 260px;
        height: min(list.preferred-height, root.height - Layout.bar-height - 2 * Layout.gutter);
        x: parent.width - self.width - Layout.gutter;
        y: parent.height - Layout.bar-height - self.height - Layout.gutter;
        border-radius: 12px;
        background: Theme.overlay-card;
        clip: true;

        list := VerticalLayout {
            padding: 8px;
            for track in root.subtitle-tracks: Rectangle {
                height: 48px;
                border-radius: 8px;
                background: item-touch.pressed ? Theme.overlay-button : (track.selected || item-touch.has-hover) ? rgba(255, 255, 255, 0.06) : transparent;

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: (track.selected ? "* " : "  ") + track.label;
                    color: Theme.text;
                    font-size: Theme.body-size;
                    overflow: elide;
                    vertical-alignment: center;
                }

                item-touch := TouchArea {
                    clicked => {
                        root.select-subtitle(track.id);
                        root.show-subtitles = false;
                    }
                }
            }
        }
    }
}


component BrowserRow inherits Rectangle {
    in property <BrowserItem> item;
    in property <bool> removable;
    callback clicked();
    callback remove();

    height: 64px;
    border-radius: Theme.radius-medium;
    background: touch.pressed ? Theme.pressed(Theme.surface) : touch.has-hover ? Theme.surface : transparent;

    animate background {
        duration: touch.pressed ? 0ms : Theme.hover-duration;
    }

    // Kind icon. Thumbnails replace it for videos later (M2).
    badge := Rectangle {
        x: Layout.gutter;
        width: Theme.touch-target;
        height: Theme.touch-target;
        border-radius: Theme.radius-medium;
        background: Theme.surface-raised;

        Image {
            width: Theme.icon-size;
            height: Theme.icon-size;
            source: root.item.kind == 0 ? Icons.drive : root.item.kind == 1 ? Icons.folder : Icons.video;
            colorize: root.item.kind == 2 && !root.item.watched ? Theme.accent : Theme.text-muted;
        }
    }

    VerticalLayout {
        x: badge.x + badge.width + Layout.gutter;
        width: (root.removable ? remove.x : parent.width) - self.x - Layout.gutter;
        alignment: center;

        Text {
            text: root.item.label;
            color: root.item.watched ? Theme.text-muted : Theme.text;
            font-size: Theme.body-size;
            font-weight: root.item.watched ? Theme.body-weight : Theme.body-strong-weight;
            overflow: elide;
        }

        if root.item.detail != "": Text {
            text: root.item.detail;
            color: Theme.text-faint;
            font-size: Theme.meta-size;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // In-progress bar along the bottom of the row.
    if root.item.progress >= 0: Rectangle {
        x: badge.x + badge.width + Layout.gutter;
        y: parent.height - 8px;
        width: parent.width - self.x - Layout.gutter;
        height: 3px;
        background: Theme.line-strong;

        Rectangle {
            x: 0;
            width: parent.width * root.item.progress;
            background: Theme.accent;
        }
    }

    // After the row's TouchArea, so it gets the clicks.
    remove := IconButton {
        x: parent.width - self.width - Layout.gutter;
        y: (parent.height - self.height) / 2;
        visible: root.removable;
        enabled: root.removable;
        icon: Icons.close;
        label: "Remove source";
        clicked => { root.remove(); }
    }
}

component BrowserPage inherits Rectangle {
    in property <string> heading;
    in property <bool> can-go-up;
    in property <bool> at-sources;
    in property <[BrowserItem]> items;
    in property <bool> loading;
    in property <string> error;
    // Resume setting for this folder (or the default, on the source list).
    in property <string> resume-label;
    callback up();
    callback activate(int);
    callback remove(int);
    callback add-source(string);
    callback cycle-resume();

    property <bool> adding;
    changed adding => {
        if (self.adding) {
            path.focus();
        }
    }

    background: Theme.bg;

    top := Rectangle {
        x: 0;
        y: 0;
        height: Layout.button-size + 2 * Layout.gutter;

        if root.can-go-up: IconButton {
            x: Layout.gutter;
            y: Layout.gutter;
            icon: Icons.back;
            label: "Up";
            clicked => { root.up(); }
        }

        Text {
            x: root.can-go-up ? Layout.gutter * 2 + Theme.touch-target : Layout.gutter;
            width: resume.x - self.x - Layout.gutter;
            text: root.heading;
            color: Theme.text;
            font-size: Theme.section-size;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        resume := PillButton {
            x: add.x - self.width - Layout.gutter;
            y: Layout.gutter;
            text: root.resume-label;
            clicked => { root.cycle-resume(); }
        }

        add := IconButton {
            x: parent.width - self.width - Layout.gutter;
            y: Layout.gutter;
            variant: root.adding ? ButtonVariant.outline : ButtonVariant.primary;
            icon: root.adding ? Icons.close : Icons.add;
            label: root.adding ? "Close" : "Add source";
            clicked => { root.adding = !root.adding; }
        }
    }

    add-row := Rectangle {
        x: 0;
        y: top.height;
        height: root.adding ? 64px : 0px;
        visible: root.adding;

        path := LineEdit {
            x: Layout.gutter;
            y: (parent.height - self.height) / 2;
            width: open.x - self.x - Layout.gutter;
            height: 48px;
            font-size: Theme.body-size;
            placeholder-text: "Folder path, mount or \\\\server\\share";
            accepted(text) => {
                if (text != "") {
                    root.add-source(text);
                    self.text = "";
                    root.adding = false;
                }
            }
        }

        open := PillButton {
            x: parent.width - self.width - Layout.gutter;
            y: (parent.height - self.height) / 2;
            variant: ButtonVariant.primary;
            text: "Open";
            clicked => {
                if (path.text != "") {
                    root.add-source(path.text);
                    path.text = "";
                    root.adding = false;
                }
            }
        }
    }

    list := ListView {
        x: 0;
        y: add-row.y + add-row.height;
        width: parent.width;
        height: parent.height - self.y;

        for item[index] in root.items: BrowserRow {
            item: item;
            removable: root.at-sources;
            clicked => { root.activate(index); }
            remove => { root.remove(index); }
        }
    }

    if root.loading || root.error != "" || root.items.length == 0: Text {
        x: Layout.gutter;
        y: list.y;
        width: parent.width - 2 * Layout.gutter;
        height: list.height;
        text: root.loading ? "Loading..."
            : root.error != "" ? root.error
            : root.can-go-up ? "No folders or videos here."
            : "No sources yet. Use Add to open a folder.";
        color: root.error != "" && !root.loading ? Theme.danger : Theme.text-muted;
        font-size: Theme.body-size;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Invisible strip along the PiP window's edge or corner that starts an OS resize
// in `direction` (0 = north, then clockwise to 7 = north-west).
// Playback controls for the browser window, so the PiP video can be
// controlled while browsing for something else.
component NowPlayingBar inherits Rectangle {
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <string> title;
    in property <string> message;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback show-video();
    callback stop();

    height: Layout.bar-height + 28px;
    background: Theme.sidebar;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    Text {
        x: Layout.gutter;
        y: 10px;
        width: time.x - self.x - Layout.gutter;
        height: 20px;
        text: root.message != "" ? root.message : root.title;
        color: root.message != "" ? Theme.danger : Theme.text;
        font-size: Theme.body-size;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }

    time := Text {
        x: parent.width - self.width - Layout.gutter;
        y: 10px;
        width: 130px;
        height: 20px;
        text: root.position-text + " / " + root.duration-text;
        color: Theme.text-muted;
        font-size: Theme.meta-size;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    controls := Rectangle {
        y: 28px;
        height: Layout.bar-height;

        back10 := IconButton {
            x: Layout.gutter;
            y: (parent.height - self.height) / 2;
            icon: Icons.back-10;
            label: "Back 10 seconds";
            clicked => { root.seek-relative(-10); }
        }

        play := IconButton {
            x: back10.x + back10.width + Layout.gutter / 2;
            y: (parent.height - self.height) / 2;
            variant: ButtonVariant.primary;
            icon: root.paused ? Icons.play : Icons.pause;
            label: root.paused ? "Play" : "Pause";
            clicked => { root.toggle-pause(); }
        }

        fwd10 := IconButton {
            x: play.x + play.width + Layout.gutter / 2;
            y: (parent.height - self.height) / 2;
            icon: Icons.forward-30;
            label: "Forward 30 seconds";
            clicked => { root.seek-relative(30); }
        }

        stop := IconButton {
            x: parent.width - self.width - Layout.gutter;
            y: (parent.height - self.height) / 2;
            icon: Icons.close;
            label: "Stop";
            clicked => { root.stop(); }
        }

        video := PillButton {
            x: stop.x - self.width - Layout.gutter / 2;
            y: (parent.height - self.height) / 2;
            icon: Icons.pip-exit;
            text: "Back to video";
            clicked => { root.show-video(); }
        }

        SeekBar {
            x: fwd10.x + fwd10.width + Layout.gutter;
            width: max(0px, video.x - self.x - Layout.gutter);
            y: (parent.height - self.height) / 2;
            position: root.position;
            duration: root.duration;
            seek(t) => { root.seek(t); }
        }
    }
}

component ResizeHandle inherits TouchArea {
    in property <int> direction;
    // Direction and the press point in window coordinates.
    callback start(int, length, length);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.start(root.direction, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

// Picture-in-picture controls, shown over the video while the main window
// is the PiP mini player. Drag anywhere to move, drag an edge or corner to
// resize, double-click or "Exit" to return.
component PipOverlay inherits Rectangle {

    // The press point in window coordinates is where the drag starts.
    callback start-move(length, length);
    callback start-resize(int, length, length);
    callback exit-pip();

    // Width of the resize strips along the edges, and size of the corners.
    property <length> edge: 8px;
    property <length> corner: 20px;

    property <bool> hover: move-area.has-hover || exit.has-hover || grip-touch.has-hover;

    move-area := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.start-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => { root.exit-pip(); }
    }

    // Edges first, then corners on top of them.
    ResizeHandle {
        x: root.corner; y: 0; width: root.width - 2 * root.corner; height: root.edge;
        direction: 0; mouse-cursor: ns-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: root.width - root.edge; y: root.corner; width: root.edge; height: root.height - 2 * root.corner;
        direction: 2; mouse-cursor: ew-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: root.corner; y: root.height - root.edge; width: root.width - 2 * root.corner; height: root.edge;
        direction: 4; mouse-cursor: ns-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: 0; y: root.corner; width: root.edge; height: root.height - 2 * root.corner;
        direction: 6; mouse-cursor: ew-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: root.width - root.corner; y: 0; width: root.corner; height: root.corner;
        direction: 1; mouse-cursor: nesw-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: 0; y: root.height - root.corner; width: root.corner; height: root.corner;
        direction: 5; mouse-cursor: nesw-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    ResizeHandle {
        x: 0; y: 0; width: root.corner; height: root.corner;
        direction: 7; mouse-cursor: nwse-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }

    // Controls stay visible but fade back when the pointer is away, so the
    // window stays usable on touch screens.
    exit := IconButton {
        x: parent.width - self.width - Theme.space-8;
        y: Theme.space-8;
        size: Theme.touch-target;
        variant: ButtonVariant.overlay;
        icon: Icons.pip-exit;
        label: "Back to full window";
        opacity: root.hover ? 1.0 : 0.5;
        clicked => { root.exit-pip(); }
    }

    grip := Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 32px;
        height: 32px;
        opacity: root.hover ? 1.0 : 0.5;

        // Our own corner mark: two short bars.
        Rectangle {
            x: 10px;
            y: 22px;
            width: 16px;
            height: 3px;
            background: Theme.text;
        }
        Rectangle {
            x: 23px;
            y: 9px;
            width: 3px;
            height: 16px;
            background: Theme.text;
        }

        grip-touch := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-resize(3, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.page == 1 && root.video-title != "" ? root.video-title + " - Enthuse" : "Enthuse";
    preferred-width: 640px;
    preferred-height: 480px;
    // PiP turns this window into a small borderless player on top, so the
    // video never has to move to another window (which stalls mpv).
    min-width: root.pip-active ? 192px : 360px;
    min-height: root.pip-active ? 108px : 270px;
    no-frame: root.pip-active;
    always-on-top: root.pip-active;
    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    forward-focus: keys;

    // 0 = folder browser, 1 = player.
    in property <int> page;

    in property <string> browser-heading;
    in property <bool> browser-can-go-up;
    in property <bool> browser-at-sources: true;
    in property <[BrowserItem]> browser-items;
    in property <bool> browser-loading;
    in property <string> browser-error;
    in property <string> browser-resume-label;
    callback browser-cycle-resume();
    callback browser-up();
    callback browser-activate(int);
    callback browser-remove(int);
    callback add-source(string);

    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> video-title;
    in property <string> message;
    in property <[TrackItem]> subtitle-tracks;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback select-subtitle(int);
    callback back();
    in property <bool> pip-active;
    callback toggle-pip();
    callback pip-start-move(length, length);
    callback pip-start-resize(int, length, length);
    // Display aspect ratio of the video (width / height), 0 if unknown.
    in property <float> video-aspect;
    callback video-aspect-changed();
    changed video-aspect => { root.video-aspect-changed(); }
    // Rust-side plumbing: invoked on the UI thread when player events wait.
    callback player-events-pending();

    changed page => { keys.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (root.page == 0) {
                if (e.text == Key.Escape || e.text == Key.Backspace) {
                    root.browser-up();
                    return accept;
                }
                return reject;
            }
            if (e.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (e.text == Key.Escape) {
                if (root.pip-active) {
                    root.toggle-pip();
                } else {
                    root.back();
                }
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.seek-relative(-10);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.seek-relative(10);
                return accept;
            }
            reject
        }

        if root.page == 0: BrowserPage {
            heading: root.browser-heading;
            can-go-up: root.browser-can-go-up;
            at-sources: root.browser-at-sources;
            items: root.browser-items;
            loading: root.browser-loading;
            error: root.browser-error;
            resume-label: root.browser-resume-label;
            cycle-resume => { root.browser-cycle-resume(); }
            up => { root.browser-up(); }
            activate(i) => { root.browser-activate(i); }
            remove(i) => { root.browser-remove(i); }
            add-source(path) => { root.add-source(path); }
        }

        if root.page == 1 && !root.pip-active: PlayerPage {
            paused: root.paused;
            position: root.position;
            duration: root.duration;
            position-text: root.position-text;
            duration-text: root.duration-text;
            title: root.video-title;
            message: root.message;
            subtitle-tracks: root.subtitle-tracks;
            toggle-pause => { root.toggle-pause(); }
            seek(t) => { root.seek(t); }
            select-subtitle(id) => { root.select-subtitle(id); }
            back => { root.back(); }
            toggle-pip => { root.toggle-pip(); }
        }

        if root.page == 1 && root.pip-active: PipOverlay {
            start-move(x, y) => { root.pip-start-move(x, y); }
            start-resize(d, x, y) => { root.pip-start-resize(d, x, y); }
            exit-pip => { root.toggle-pip(); }
        }
    }
}

// The browser in its own window, while the main window is the PiP player.
// Same browser properties as AppWindow, so the app can drive either.
export component BrowserWindow inherits Window {
    title: "Enthuse";
    preferred-width: 640px;
    preferred-height: 480px;
    min-width: 360px;
    min-height: 360px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    forward-focus: keys;

    in property <string> browser-heading;
    in property <bool> browser-can-go-up;
    in property <bool> browser-at-sources: true;
    in property <[BrowserItem]> browser-items;
    in property <bool> browser-loading;
    in property <string> browser-error;
    in property <string> browser-resume-label;
    callback browser-cycle-resume();
    callback browser-up();
    callback browser-activate(int);
    callback browser-remove(int);
    callback add-source(string);

    // The video playing in the PiP window.
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> video-title;
    in property <string> message;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback show-video();
    callback stop();

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Backspace) {
                root.browser-up();
                return accept;
            }
            reject
        }

        VerticalLayout {
            BrowserPage {
                heading: root.browser-heading;
                can-go-up: root.browser-can-go-up;
                at-sources: root.browser-at-sources;
                items: root.browser-items;
                loading: root.browser-loading;
                error: root.browser-error;
                resume-label: root.browser-resume-label;
                cycle-resume => { root.browser-cycle-resume(); }
                up => { root.browser-up(); }
                activate(i) => { root.browser-activate(i); }
                remove(i) => { root.browser-remove(i); }
                add-source(path) => { root.add-source(path); }
            }

            NowPlayingBar {
                paused: root.paused;
                position: root.position;
                duration: root.duration;
                position-text: root.position-text;
                duration-text: root.duration-text;
                title: root.video-title;
                message: root.message;
                toggle-pause => { root.toggle-pause(); }
                seek(t) => { root.seek(t); }
                seek-relative(d) => { root.seek-relative(d); }
                show-video => { root.show-video(); }
                stop => { root.stop(); }
            }
        }
    }
}
