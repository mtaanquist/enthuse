// Enthuse main window: the app screens (sidebar shell) and the player.

import { Theme, Icons, KeyFocus } from "theme.slint";

export { KeyFocus }
import { ButtonVariant, IconButton, PillButton } from "components/buttons.slint";
import { Section, Shell } from "components/sidebar.slint";
import { FocusGrid } from "components/behavior.slint";
import { BrowserModel, BrowserPage, Toast } from "browser.slint";
import { HomeModel, HomePage } from "home.slint";
import { PlayerModel, PlayerPage } from "player.slint";
import { SettingsModel, SettingsPage } from "settings.slint";
import { RecentModel, RecentPage } from "recent.slint";

export { BrowserModel, BrowserItem, ItemKind, ItemBadge } from "browser.slint";
export { HomeModel, ContinueItem, SourceTileItem, SourceIcon } from "home.slint";
export { PlayerModel, PlayerLayout, TrackItem } from "player.slint";
export { SettingsModel, OverrideItem } from "settings.slint";
export { RecentModel } from "recent.slint";

export { Section }
//
// The window background is transparent so the video, drawn underneath by
// mpv, shows through. Pages that are not the player draw their own
// opaque background.



// Geometry of the now-playing bar in the browser window.
export global Layout {
    out property <length> bar-height: 72px;
    out property <length> gutter: Theme.space-24;
}

// Thin progress line along the top of the now-playing bar. Tap or drag to
// seek; the hit area is taller than the line, and the thumb shows on hover.
component ProgressLine inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    callback seek(float);

    height: 16px;
    accessible-role: slider;
    accessible-label: "Position";
    accessible-value: root.position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;

    property <float> fraction: root.duration > 0 ? clamp(root.position / root.duration, 0, 1) : 0;
    property <bool> active: touch.has-hover || touch.pressed;

    Rectangle {
        y: 0;
        height: root.active ? 4px : 3px;
        background: Theme.track;

        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            background: Theme.accent;
        }
    }

    if root.active: Rectangle {
        x: root.width * root.fraction - self.width / 2;
        y: 2px - self.height / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.on-video;
    }

    touch := TouchArea {
        function seek-to(x: length) {
            if (root.duration > 0) {
                root.seek(clamp(x / self.width, 0, 1) * root.duration);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.seek-to(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.seek-to(self.mouse-x);
            }
        }
    }
}

// Playback controls for the browser window, so the PiP video can be
// controlled while browsing for something else (docs/ui.md, "PiP").
component NowPlayingBar inherits Rectangle {
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <string> title;
    in property <string> message;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback show-video();
    callback stop();

    // Below this width the seek buttons go and the pill loses its text.
    property <bool> narrow: root.width < 640px;

    height: Layout.bar-height;
    background: Theme.sidebar;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    // Below the progress line's hit area, and sized by the bar, not the
    // other way round (that would make `narrow` a binding loop).
    HorizontalLayout {
        x: 0;
        y: 16px;
        width: root.width;
        height: root.height - 16px;
        padding-left: Layout.gutter;
        padding-right: Layout.gutter;
        padding-bottom: Theme.space-4;
        spacing: Theme.space-8;
        alignment: stretch;

        if !root.narrow: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.back-10;
            label: "Back 10 seconds";
            clicked => { root.seek-relative(-10); }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            variant: ButtonVariant.light;
            icon: root.paused ? Icons.play : Icons.pause;
            label: root.paused ? "Play" : "Pause";
            clicked => { root.toggle-pause(); }
        }

        if !root.narrow: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.forward-30;
            label: "Forward 30 seconds";
            clicked => { root.seek-relative(30); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-left: Theme.space-8;
            spacing: 2px;

            Text {
                text: root.message != "" ? root.message : root.title;
                color: root.message != "" ? Theme.danger : Theme.text;
                font-size: Theme.body-size;
                font-weight: Theme.body-strong-weight;
                overflow: elide;
            }

            Text {
                text: root.position-text + " / " + root.duration-text;
                color: Theme.text-muted;
                font-size: Theme.meta-size;
                overflow: elide;
            }
        }

        if !root.narrow: PillButton {
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            icon: Icons.pip-exit;
            text: "Back to video";
            clicked => { root.show-video(); }
        }

        if root.narrow: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.pip-exit;
            label: "Back to video";
            clicked => { root.show-video(); }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.close;
            label: "Stop";
            clicked => { root.stop(); }
        }
    }

    ProgressLine {
        y: 0;
        position: root.position;
        duration: root.duration;
        seek(t) => { root.seek(t); }
    }
}

// Invisible strip along the PiP window's edge or corner that starts an OS resize
// in `direction` (0 = north, then clockwise to 7 = north-west).
component ResizeHandle inherits TouchArea {
    in property <int> direction;
    // Direction and the press point in window coordinates.
    callback start(int, length, length);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.start(root.direction, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

// Picture-in-picture controls, shown over the video while the main window
// is the PiP mini player. Drag anywhere to move, drag an edge or corner to
// resize, double-click or "Exit" to return.
component PipOverlay inherits Rectangle {
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;

    // The press point in window coordinates is where the drag starts.
    callback start-move(length, length);
    callback start-resize(int, length, length);
    callback exit-pip();
    callback close();
    callback toggle-pause();
    callback seek-relative(float);

    // Width of the resize strips along the edges, and size of the corners.
    property <length> edge: 8px;
    property <length> corner: 20px;

    // A tap (touch has no hover) shows the controls for a while.
    property <bool> tapped;
    property <bool> hover: move-area.has-hover || exit.has-hover || close.has-hover || back10.has-hover || play.has-hover || fwd30.has-hover || grip-touch.has-hover
        || edge1.has-hover || edge2.has-hover || edge3.has-hover || edge4.has-hover
        || edge5.has-hover || edge6.has-hover || edge7.has-hover;
    property <bool> show: root.hover || root.tapped || root.paused;
    // Below this height the seek buttons go, so play still fits.
    property <bool> small: root.height < 150px || root.width < 260px;

    tap-timer := Timer {
        interval: 3s;
        running: root.tapped;
        triggered => { root.tapped = false; }
    }

    // Shows the controls for another 3 s, after a tap or a button press.
    function poke() {
        root.tapped = true;
        tap-timer.restart();
    }

    move-area := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.poke();
                root.start-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => { root.exit-pip(); }
    }

    // Scrim and controls (docs/ui.md, PipControls).
    Rectangle {
        background: rgba(0, 0, 0, 0.42);
        opacity: root.show ? 1 : 0;

        animate opacity {
            duration: 150ms;
        }
    }

    // Edges first, then corners on top of them.
    edge1 := ResizeHandle {
        x: root.corner; y: 0; width: root.width - 2 * root.corner; height: root.edge;
        direction: 0; mouse-cursor: ns-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge2 := ResizeHandle {
        x: root.width - root.edge; y: root.corner; width: root.edge; height: root.height - 2 * root.corner;
        direction: 2; mouse-cursor: ew-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge3 := ResizeHandle {
        x: root.corner; y: root.height - root.edge; width: root.width - 2 * root.corner; height: root.edge;
        direction: 4; mouse-cursor: ns-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge4 := ResizeHandle {
        x: 0; y: root.corner; width: root.edge; height: root.height - 2 * root.corner;
        direction: 6; mouse-cursor: ew-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge5 := ResizeHandle {
        x: root.width - root.corner; y: 0; width: root.corner; height: root.corner;
        direction: 1; mouse-cursor: nesw-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge6 := ResizeHandle {
        x: 0; y: root.height - root.corner; width: root.corner; height: root.corner;
        direction: 5; mouse-cursor: nesw-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }
    edge7 := ResizeHandle {
        x: 0; y: 0; width: root.corner; height: root.corner;
        direction: 7; mouse-cursor: nwse-resize; start(d, x, y) => { root.start-resize(d, x, y); }
    }

    // The buttons only take input while shown; a tap elsewhere shows them.
    exit := IconButton {
        x: Theme.space-12;
        y: Theme.space-12;
        size: Theme.touch-target;
        variant: ButtonVariant.overlay;
        icon: Icons.pip-exit;
        label: "Back to full window";
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0;
        clicked => {
            root.poke();
            root.exit-pip();
        }

        animate opacity {
            duration: 150ms;
        }
    }

    close := IconButton {
        x: parent.width - self.width - Theme.space-12;
        y: Theme.space-12;
        size: Theme.touch-target;
        variant: ButtonVariant.overlay;
        icon: Icons.close;
        label: "Stop and close";
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0;
        clicked => {
            root.poke();
            root.close();
        }

        animate opacity {
            duration: 150ms;
        }
    }

    play := IconButton {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: Theme.pip-play-size;
        variant: ButtonVariant.light;
        icon: root.paused ? Icons.play : Icons.pause;
        label: root.paused ? "Play" : "Pause";
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0;
        clicked => {
            root.poke();
            root.toggle-pause();
        }

        animate opacity {
            duration: 150ms;
        }
    }

    back10 := IconButton {
        x: play.x - self.width - Theme.space-20;
        y: (parent.height - self.height) / 2;
        size: Theme.touch-target;
        variant: ButtonVariant.overlay;
        icon: Icons.back-10;
        label: "Back 10 seconds";
        opacity: root.show && !root.small ? 1 : 0;
        visible: self.opacity > 0;
        clicked => {
            root.poke();
            root.seek-relative(-10);
        }

        animate opacity {
            duration: 150ms;
        }
    }

    fwd30 := IconButton {
        x: play.x + play.width + Theme.space-20;
        y: (parent.height - self.height) / 2;
        size: Theme.touch-target;
        variant: ButtonVariant.overlay;
        icon: Icons.forward-30;
        label: "Forward 30 seconds";
        opacity: root.show && !root.small ? 1 : 0;
        visible: self.opacity > 0;
        clicked => {
            root.poke();
            root.seek-relative(30);
        }

        animate opacity {
            duration: 150ms;
        }
    }

    grip := Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 32px;
        height: 32px;
        opacity: root.show ? 1.0 : 0.4;

        // Our own corner mark: two short bars.
        Rectangle {
            x: 12px;
            y: 22px;
            width: 12px;
            height: 2px;
            background: Theme.on-video;
        }
        Rectangle {
            x: 22px;
            y: 12px;
            width: 2px;
            height: 12px;
            background: Theme.on-video;
        }

        grip-touch := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-resize(3, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }

    // Progress along the bottom edge, always visible.
    Rectangle {
        y: parent.height - self.height;
        height: 4px;
        background: Theme.track;

        Rectangle {
            x: 0;
            width: parent.width * (root.duration > 0 ? clamp(root.position / root.duration, 0, 1) : 0);
            background: Theme.accent;
        }
    }
}

// The app screens with the sidebar: everything except the player. Used by
// the main window, and by the browser window while PiP is on.
component AppScreens inherits Rectangle {
    in-out property <Section> section;

    // Switching screens, folders or views destroys whatever had keyboard
    // focus (a row, the list), and Slint then drops key presses. Hand focus
    // back to the window so Escape and the other shortcuts keep working.
    property <int> view-mode: BrowserModel.view-mode;
    property <bool> loading: BrowserModel.loading;
    property <bool> at-sources: BrowserModel.at-sources;
    changed section => {
        KeyFocus.restore();
        // Pick up sources that came back online or went away.
        if (root.section == Section.home) {
            HomeModel.refresh();
        }
        // Folder overrides may have changed while browsing.
        if (root.section == Section.settings) {
            SettingsModel.refresh();
        }
        if (root.section == Section.recent) {
            RecentModel.refresh();
        }
    }
    changed view-mode => { KeyFocus.restore(); }
    changed loading => { KeyFocus.restore(); }
    changed at-sources => { KeyFocus.restore(); }


    Shell {
        section <=> root.section;

        if root.section == Section.home: HomePage {
            open-source(index) => {
                HomeModel.open-source(index);
                root.section = Section.browse;
            }
        }

        if root.section == Section.browse: BrowserPage { }

        if root.section == Section.recent: RecentPage { }

        if root.section == Section.settings: SettingsPage { }
    }

    Toast { }

    // Escape (or Backspace) goes up a folder in Browse, and from the top of
    // a section back to Home. Returns whether the key was used.
    public function back() -> bool {
        if (root.section == Section.browse && BrowserModel.can-go-up) {
            BrowserModel.up();
            return true;
        }
        if (root.section != Section.home) {
            root.section = Section.home;
            return true;
        }
        false
    }
}

export component AppWindow inherits Window {
    // A fixed title in PiP, so a window manager rule can match it (README).
    title: root.pip-active ? "Enthuse PiP" : root.page == 1 && root.video-title != "" ? root.video-title + " - Enthuse" : "Enthuse";
    preferred-width: 1120px;
    preferred-height: 720px;
    // PiP turns this window into a small borderless player on top, so the
    // video never has to move to another window (which stalls mpv).
    min-width: root.pip-active ? 192px : 360px;
    min-height: root.pip-active ? 108px : 270px;
    no-frame: root.pip-active;
    always-on-top: root.pip-active;
    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    forward-focus: keys;

    // 0 = app screens (see `section`), 1 = player.
    in property <int> page;
    in-out property <Section> section: Section.home;


    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> video-title;
    in property <string> message;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback back();
    in property <bool> pip-active;
    callback toggle-pip();
    callback pip-start-move(length, length);
    callback pip-start-resize(int, length, length);
    // Display aspect ratio of the video (width / height), 0 if unknown.
    in property <float> video-aspect;
    callback video-aspect-changed();
    changed video-aspect => { root.video-aspect-changed(); }
    // Rust-side plumbing: invoked on the UI thread when player events wait.
    callback player-events-pending();

    changed page => { keys.focus(); }
    changed pip-active => { keys.focus(); }
    // Rust connects KeyFocus.restore to this.
    public function focus-keys() { keys.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (root.page == 0) {
                if (e.text == Key.Escape || e.text == Key.Backspace) {
                    return screens.back() ? EventResult.accept : EventResult.reject;
                }
                // Nothing focused, or a button that doesn't use arrows:
                // start on the screen's first visible item.
                if (FocusGrid.is-arrow(e.text)) {
                    KeyFocus.focus-first();
                    return accept;
                }
                return reject;
            }
            if (e.text == Key.Escape) {
                if (PlayerModel.menu != 0 && !root.pip-active) {
                    PlayerModel.menu = 0;
                } else if (root.pip-active) {
                    root.toggle-pip();
                } else if (PlayerModel.fullscreen) {
                    PlayerModel.toggle-fullscreen();
                } else {
                    root.back();
                }
                return accept;
            }
            if (root.pip-active) {
                if (e.text == " ") {
                    root.toggle-pause();
                    return accept;
                }
                return reject;
            }
            // Any other key shows the controls, as a mouse move does.
            PlayerModel.activity();
            if (e.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.seek-relative(-10);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.seek-relative(10);
                return accept;
            }
            if (e.text == Key.UpArrow) {
                PlayerModel.step-volume(5);
                return accept;
            }
            if (e.text == Key.DownArrow) {
                PlayerModel.step-volume(-5);
                return accept;
            }
            if (e.text == "f" || e.text == "F") {
                PlayerModel.toggle-fullscreen();
                return accept;
            }
            if (e.text == "m" || e.text == "M") {
                PlayerModel.toggle-mute();
                return accept;
            }
            reject
        }

        screens := AppScreens {
            visible: root.page == 0;
            section <=> root.section;
        }

        if root.page == 1 && !root.pip-active: PlayerPage {
            paused: root.paused;
            position: root.position;
            duration: root.duration;
            position-text: root.position-text;
            title: root.video-title;
            message: root.message;
            toggle-pause => { root.toggle-pause(); }
            seek(t) => { root.seek(t); }
            seek-relative(d) => { root.seek-relative(d); }
            back => { root.back(); }
            toggle-pip => { root.toggle-pip(); }
        }

        if root.page == 1 && root.pip-active: PipOverlay {
            paused: root.paused;
            position: root.position;
            duration: root.duration;
            start-move(x, y) => { root.pip-start-move(x, y); }
            start-resize(d, x, y) => { root.pip-start-resize(d, x, y); }
            exit-pip => { root.toggle-pip(); }
            close => { root.back(); }
            toggle-pause => { root.toggle-pause(); }
            seek-relative(d) => { root.seek-relative(d); }
        }
    }
}

// The browser in its own window, while the main window is the PiP player.
// Same browser properties as AppWindow, so the app can drive either.
export component BrowserWindow inherits Window {
    title: "Enthuse";
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 360px;
    min-height: 360px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    forward-focus: keys;

    in-out property <Section> section: Section.home;

    // The video playing in the PiP window.
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> video-title;
    in property <string> message;
    callback toggle-pause();
    callback seek(float);
    callback seek-relative(float);
    callback show-video();
    callback stop();

    // Rust connects KeyFocus.restore to this.
    public function focus-keys() { keys.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Backspace) {
                return side-screens.back() ? EventResult.accept : EventResult.reject;
            }
            if (FocusGrid.is-arrow(e.text)) {
                KeyFocus.focus-first();
                return accept;
            }
            reject
        }

        VerticalLayout {
            side-screens := AppScreens {
                section <=> root.section;
            }

            NowPlayingBar {
                paused: root.paused;
                position: root.position;
                duration: root.duration;
                position-text: root.position-text;
                duration-text: root.duration-text;
                title: root.video-title;
                message: root.message;
                toggle-pause => { root.toggle-pause(); }
                seek(t) => { root.seek(t); }
                seek-relative(d) => { root.seek-relative(d); }
                show-video => { root.show-video(); }
                stop => { root.stop(); }
            }
        }
    }
}
