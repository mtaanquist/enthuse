// Shared pointer and keyboard behavior for anything tappable: hover and
// pressed state, Enter or Space to activate, and a focus ring that only
// shows when focus came from the keyboard. Place it as the last child, filling
// its parent, and forward the parent's focus to it.

import { Theme, KeyFocus } from "../theme.slint";

export component ButtonBehavior {
    in property <bool> enabled: true;
    // Corner radius of the parent, so the ring follows its shape.
    in property <length> ring-radius;
    // Off when the parent shows keyboard focus itself, e.g. a row inside a
    // clipped card where the ring outside would be cut off.
    in property <bool> show-ring: true;
    // Keep keyboard focus here after Enter or Space, for buttons that stay
    // on screen when pressed (steppers, switches). Others hand focus back
    // to the window, since their action may hide or destroy them.
    in property <bool> keep-focus;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    out property <bool> keyboard-focus;
    callback clicked();
    // An arrow key while focused (Key.UpArrow and so on). Lists and grids
    // move focus with it; return true when the key was used.
    callback arrow(string) -> bool;

    width: 100%;
    height: 100%;
    forward-focus: focus;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            // A pointer click ends keyboard navigation: shortcuts apply again.
            if (focus.has-focus) {
                KeyFocus.restore();
            }
            root.clicked();
        }
    }

    focus := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            // Programmatic focus comes from arrow keys (lists and grids).
            root.keyboard-focus = reason == FocusReason.tab-navigation || reason == FocusReason.programmatic;
        }
        focus-lost(reason) => {
            root.keyboard-focus = false;
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // The action may hide or destroy this button, which would
                // leave no item to receive keys. Hand focus back first.
                if (!root.keep-focus) {
                    KeyFocus.restore();
                }
                root.clicked();
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                return root.arrow(event.text) ? EventResult.accept : EventResult.reject;
            }
            reject
        }
    }

    property <length> ring-outset: Theme.focus-ring-width + Theme.focus-ring-offset;

    if root.show-ring && root.keyboard-focus && root.enabled: Rectangle {
        x: -root.ring-outset;
        y: -root.ring-outset;
        width: root.width + 2 * root.ring-outset;
        height: root.height + 2 * root.ring-outset;
        border-radius: root.ring-radius + root.ring-outset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.accent;
    }
}

// Where an arrow key moves focus in a grid of `count` items with `columns`
// per row (1 for a list, `count` for a single row): the new index, or -1
// at an edge or for another key.
export global FocusGrid {
    public pure function target(index: int, count: int, columns: int, key: string) -> int {
        if (key == Key.DownArrow) {
            return index + columns < count ? index + columns : -1;
        }
        if (key == Key.UpArrow) {
            return index - columns >= 0 ? index - columns : -1;
        }
        if (columns > 1 && key == Key.RightArrow) {
            return index + 1 < count && mod(index + 1, columns) != 0 ? index + 1 : -1;
        }
        if (columns > 1 && key == Key.LeftArrow) {
            return index > 0 && mod(index, columns) != 0 ? index - 1 : -1;
        }
        -1
    }

    // Whether `key` is an arrow key.
    public pure function is-arrow(key: string) -> bool {
        key == Key.UpArrow || key == Key.DownArrow || key == Key.LeftArrow || key == Key.RightArrow
    }
}
