// Settings screen (#69): libraries (#59), playback, folder overrides,
// thumbnails, about.
// Rust fills SettingsModel for each window and saves every change at once;
// the screen only displays it.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { ButtonVariant, IconButton, PillButton } from "components/buttons.slint";
import { ButtonBehavior } from "components/behavior.slint";

// A folder with its own settings.
export struct OverrideItem {
    // Folder name, or the source's name for its top folder.
    folder: string,
    // "NAS / Shows / Kids, resume off"
    detail: string,
}

// A saved library, in list order: favourites first.
export struct LibraryItem {
    // Its database id: rows move, so state such as which one is open
    // follows the id, not the index.
    id: int,
    name: string,
    // Folder path or share.
    location: string,
    network: bool,
    favorite: bool,
    // Left off Home; still in Libraries and here.
    hidden: bool,
    // Its own resume setting: 0 same as Playback, 1 on, 2 off.
    resume: int,
    // The first and last index of its group (favourites, or the rest): it
    // can only be moved within it.
    group-first: int,
    group-last: int,
}

export global SettingsModel {
    in property <[LibraryItem]> libraries;
    in property <bool> resume: true;
    in property <bool> auto-next: true;
    in property <bool> network-thumbnails: true;
    // 0 percentage, 1 time left, 2 whichever comes first.
    in property <int> watched-mode;
    in property <string> watched-percent: "90%";
    in property <string> watched-remaining: "2 min";
    in property <string> watched-summary;
    // Whether the steppers can still go down or up.
    in property <bool> percent-down: true;
    in property <bool> percent-up: true;
    in property <bool> remaining-down: true;
    in property <bool> remaining-up: true;
    in property <[OverrideItem]> overrides;
    in property <string> version;

    callback set-resume(bool);
    callback set-auto-next(bool);
    callback set-network-thumbnails(bool);
    callback set-watched-mode(int);
    // -1 or 1.
    callback step-percent(int);
    callback step-remaining(int);
    callback clear-override(int);
    callback library-favorite(int);
    // A new name; empty goes back to the folder's own name.
    callback library-rename(int, string);
    // A library from the first index to the second (dragged, or moved one
    // place with the arrows).
    callback library-move(int, int);
    // Forgets the library and its watch state.
    callback library-remove(int);
    // Shows it on Home (true) or leaves it off.
    callback library-show(int, bool);
    // 0 same as Playback, 1 on, 2 off.
    callback library-resume(int, int);
    // Asks Rust to load everything again, e.g. when the screen shows.
    callback refresh();
}

component SectionHeading inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.section-size;
    font-weight: Theme.section-weight;
    vertical-alignment: center;
}

// An on/off switch. The whole row is the tap target (see SwitchRow); this
// is the drawing.
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> hover;

    width: 48px;
    height: 28px;
    border-radius: self.height / 2;
    background: root.on ? (root.hover ? Theme.hovered(Theme.accent) : Theme.accent) : (root.hover ? Theme.line-strong.brighter(0.2) : Theme.line-strong);

    animate background {
        duration: Theme.hover-duration;
    }

    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        width: 20px;
        height: 20px;
        border-radius: self.height / 2;
        background: root.on ? Theme.on-accent : Theme.text-muted;

        animate x {
            duration: Theme.hover-duration;
        }
    }
}

// Title, an optional description, and a control on the right.
component RowText inherits VerticalLayout {
    in property <string> title;
    in property <string> description;

    alignment: center;
    spacing: Theme.space-4;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.body-size;
        font-weight: Theme.body-weight;
        wrap: word-wrap;
    }

    if root.description != "": Text {
        text: root.description;
        color: Theme.text-muted;
        font-size: Theme.meta-size;
        wrap: word-wrap;
    }
}

// A setting that is on or off. Tapping anywhere on the row flips it.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> on;
    callback toggled(bool);

    min-height: 64px;
    background: behavior.has-hover ? Theme.surface-raised : transparent;
    forward-focus: behavior;
    accessible-role: switch;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(!root.on); }

    animate background {
        duration: Theme.hover-duration;
    }

    HorizontalLayout {
        padding-left: Theme.space-20;
        padding-right: Theme.space-20;
        padding-top: Theme.space-12;
        padding-bottom: Theme.space-12;
        spacing: Theme.space-16;

        RowText {
            title: root.title;
            description: root.description;
        }

        VerticalLayout {
            alignment: center;

            Switch {
                on: root.on;
                hover: behavior.has-hover;
            }
        }
    }

    // Keyboard focus, drawn inside the row: the card clips anything outside.
    if behavior.keyboard-focus: Rectangle {
        border-width: Theme.focus-ring-width;
        border-color: Theme.accent;
        border-radius: Theme.radius-small;
    }

    behavior := ButtonBehavior {
        ring-radius: 0;
        show-ring: false;
        keep-focus: true;
        clicked => { root.toggled(!root.on); }
    }
}

// Text segments with one selected.
component TextSegments inherits Rectangle {
    in property <[string]> segments;
    in property <int> selected;
    callback select(int);

    // Each segment is a full touch target inside the 3px padding.
    height: Theme.touch-target + 6px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for segment[index] in root.segments: Rectangle {
            property <bool> active: index == root.selected;

            horizontal-stretch: 1;
            min-width: label.preferred-width + 2 * Theme.space-16;
            border-radius: self.height / 2;
            background: self.active ? Theme.line-strong : behavior.pressed ? Theme.pressed(Theme.surface) : behavior.has-hover ? Theme.surface : transparent;
            forward-focus: behavior;
            accessible-role: button;
            accessible-label: segment;
            accessible-checkable: true;
            accessible-checked: self.active;
            accessible-action-default => { root.select(index); }

            animate background {
                duration: Theme.hover-duration;
            }

            label := Text {
                text: segment;
                color: parent.active ? Theme.text : Theme.text-muted;
                font-size: Theme.label-size;
                font-weight: Theme.label-weight;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            behavior := ButtonBehavior {
                ring-radius: parent.border-radius;
                keep-focus: true;
                clicked => { root.select(index); }
            }
        }
    }
}

// Minus, the value, plus.
component Stepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> can-down: true;
    in property <bool> can-up: true;
    callback step(int);

    spacing: Theme.space-8;
    alignment: end;

    IconButton {
        icon: Icons.minus;
        label: "Less " + root.label;
        enabled: root.can-down;
        keep-focus: true;
        clicked => { root.step(-1); }
    }

    Text {
        width: 72px;
        text: root.value;
        color: Theme.text;
        font-size: Theme.body-size;
        font-weight: Theme.body-strong-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: root.label + ": " + root.value;
    }

    IconButton {
        icon: Icons.add;
        label: "More " + root.label;
        enabled: root.can-up;
        keep-focus: true;
        clicked => { root.step(1); }
    }
}

// A row with a title on the left and a stepper on the right.
component StepperRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    in property <bool> can-down;
    in property <bool> can-up;
    callback step(int);

    padding-left: Theme.space-20;
    padding-right: Theme.space-20;
    padding-top: Theme.space-8;
    padding-bottom: Theme.space-8;
    spacing: Theme.space-16;

    RowText {
        title: root.title;
    }

    Stepper {
        label: root.title;
        value: root.value;
        can-down: root.can-down;
        can-up: root.can-up;
        step(d) => { root.step(d); }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// A rounded group of rows.
component Card inherits Rectangle {
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.surface;
    clip: true;

    VerticalLayout {
        @children
    }
}

component SettingsSection inherits VerticalLayout {
    in property <string> title;

    spacing: Theme.space-16;

    SectionHeading {
        text: root.title;
    }

    Card {
        @children
    }
}

// One library: drag handle, name and path, favourite, up and down, and
// an expand button for its name, resume setting and removal.
component LibraryRow inherits Rectangle {
    in property <LibraryItem> item;
    in property <int> index;
    in property <bool> expanded;
    in property <bool> dragged;
    in property <bool> resume-default: true;
    callback toggle-expanded();
    callback drag-start();
    // How far the pointer moved since the last call.
    callback drag-move(length);
    callback drag-end();

    property <bool> confirm-remove;
    changed expanded => { root.confirm-remove = false; }

    background: root.dragged ? Theme.surface-raised : Theme.surface;
    drop-shadow-blur: root.dragged ? 24px : 0px;
    drop-shadow-color: rgba(0, 0, 0, 0.45);

    VerticalLayout {
        if root.index > 0: Divider { }

        HorizontalLayout {
            min-height: 72px;
            padding-left: Theme.space-8;
            padding-right: Theme.space-12;
            spacing: Theme.space-8;

            // Drag to reorder. With a finger, rest on it for a moment
            // first: a quick swipe scrolls the page instead.
            handle := Rectangle {
                width: Theme.touch-target;
                height: Theme.touch-target;
                y: (parent.height - self.height) / 2;
                accessible-role: none;

                Image {
                    width: Theme.icon-size;
                    height: Theme.icon-size;
                    source: Icons.grip;
                    colorize: handle-touch.has-hover || root.dragged ? Theme.text : Theme.text-muted;
                }

                handle-touch := TouchArea {
                    mouse-cursor: root.dragged ? grabbing : grab;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.drag-start();
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            root.drag-end();
                        }
                    }
                    // This area moves with the row, so its offset is on top
                    // of how far the row has moved already.
                    moved => { root.drag-move(self.mouse-y - self.pressed-y); }
                }
            }

            Image {
                width: Theme.icon-size;
                height: Theme.icon-size;
                y: (parent.height - self.height) / 2;
                source: root.item.network ? Icons.server : Icons.drive;
                colorize: Theme.accent;
            }

            RowText {
                horizontal-stretch: 1;
                title: root.item.name;
                description: root.item.hidden ? "Not on Home · " + root.item.location : root.item.location;
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                variant: ButtonVariant.outline;
                border-width: 0px;
                icon: root.item.favorite ? Icons.star-filled : Icons.star;
                label: root.item.favorite ? "Remove " + root.item.name + " from favourites" : "Add " + root.item.name + " to favourites";
                keep-focus: true;
                clicked => { SettingsModel.library-favorite(root.index); }
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                variant: ButtonVariant.outline;
                border-width: 0px;
                icon: Icons.chevron-up;
                label: "Move " + root.item.name + " up";
                enabled: root.index > root.item.group-first;
                keep-focus: true;
                clicked => { SettingsModel.library-move(root.index, root.index - 1); }
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                variant: ButtonVariant.outline;
                border-width: 0px;
                icon: Icons.chevron-down;
                label: "Move " + root.item.name + " down";
                enabled: root.index < root.item.group-last;
                keep-focus: true;
                clicked => { SettingsModel.library-move(root.index, root.index + 1); }
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.expanded ? Icons.chevron-up : Icons.more;
                label: (root.expanded ? "Close settings for " : "Settings for ") + root.item.name;
                keep-focus: true;
                clicked => { root.toggle-expanded(); }
            }
        }

        if root.expanded: VerticalLayout {
            padding-left: Theme.space-20;
            padding-right: Theme.space-20;
            padding-bottom: Theme.space-20;
            spacing: Theme.space-16;

            HorizontalLayout {
                spacing: Theme.space-12;

                name-field := LineEdit {
                    height: Theme.touch-target;
                    font-size: Theme.body-size;
                    text: root.item.name;
                    placeholder-text: "Leave empty for the folder's name";
                    accepted(text) => { SettingsModel.library-rename(root.index, text); }
                }

                PillButton {
                    variant: ButtonVariant.primary;
                    text: "Rename";
                    enabled: name-field.text != root.item.name;
                    clicked => { SettingsModel.library-rename(root.index, name-field.text); }
                }
            }

            // Full width of the card, like the other switch rows.
            Rectangle {
                height: show-row.preferred-height;

                show-row := SwitchRow {
                    x: -Theme.space-20;
                    width: parent.width + 2 * Theme.space-20;
                    title: "Show on Home";
                    description: "Off: it is still under Libraries in the sidebar.";
                    on: !root.item.hidden;
                    toggled(on) => { SettingsModel.library-show(root.index, on); }
                }
            }

            VerticalLayout {
                spacing: Theme.space-12;

                RowText {
                    title: "Resume where you left off";
                    description: "For this library and its folders, unless a folder has its own setting.";
                }

                TextSegments {
                    segments: [root.resume-default ? "Same as Playback (on)" : "Same as Playback (off)", "On", "Off"];
                    selected: root.item.resume;
                    select(i) => { SettingsModel.library-resume(root.index, i); }
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-12;

                PillButton {
                    icon: Icons.close;
                    variant: root.confirm-remove ? ButtonVariant.primary : ButtonVariant.outline;
                    text: root.confirm-remove ? "Remove, and forget its watch state" : "Remove library";
                    clicked => {
                        if (root.confirm-remove) {
                            SettingsModel.library-remove(root.index);
                        } else {
                            root.confirm-remove = true;
                        }
                    }
                }

                if root.confirm-remove: PillButton {
                    text: "Keep it";
                    clicked => { root.confirm-remove = false; }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <length> pad: root.width < 700px ? Theme.space-24 : Theme.content-padding-x;
    property <bool> narrow: root.width < 640px;

    // The id of the library whose settings are open, or -1.
    property <int> expanded-id: -1;
    // Dragging a library: from its index, to where it would land, and how
    // far it has moved. The rows in between slide over to make room.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <length> drag-dy;
    // The height of a collapsed row, measured when a drag starts: rows
    // shift by this much (expanded rows close first).
    property <length> row-step: 72px;

    // Where the row at `index` shows while another is dragged.
    pure function slot(index: int) -> int {
        if (root.drag-from < 0 || index == root.drag-from) {
            return index;
        }
        if (root.drag-from < root.drag-to && index > root.drag-from && index <= root.drag-to) {
            return index - 1;
        }
        if (root.drag-to < root.drag-from && index >= root.drag-to && index < root.drag-from) {
            return index + 1;
        }
        index
    }

    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: page.preferred-height;

        page := VerticalLayout {
            x: 0;
            // Readable line lengths on wide windows.
            width: min(parent.visible-width, 820px + 2 * root.pad);
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: Theme.content-padding-top;
            padding-bottom: Theme.space-48;
            spacing: Theme.space-36;

            Text {
                text: "Settings";
                color: Theme.text;
                font-size: Theme.title-size;
                font-weight: Theme.title-weight;
                letter-spacing: Theme.title-letter-spacing;
            }

            SettingsSection {
                title: "Libraries";

                if SettingsModel.libraries.length == 0: HorizontalLayout {
                    padding: Theme.space-20;

                    Text {
                        text: "No libraries yet. Add a folder or network share from Home or Libraries.";
                        color: Theme.text-muted;
                        font-size: Theme.meta-size;
                        wrap: word-wrap;
                    }
                }

                for item[index] in SettingsModel.libraries: Rectangle {
                    property <bool> dragged: index == root.drag-from;

                    height: row.preferred-height;
                    z: self.dragged ? 1 : 0;

                    row := LibraryRow {
                        y: parent.dragged ? root.drag-dy : (root.slot(index) - index) * root.row-step;
                        width: parent.width;
                        animate y {
                            duration: parent.dragged ? 0ms : Theme.hover-duration;
                        }
                        item: item;
                        index: index;
                        expanded: root.expanded-id == item.id;
                        dragged: parent.dragged;
                        resume-default: SettingsModel.resume;
                        toggle-expanded => {
                            root.expanded-id = root.expanded-id == item.id ? -1 : item.id;
                        }
                        drag-start => {
                            // Rows have one height while dragging.
                            root.expanded-id = -1;
                            root.row-step = max(1px, parent.height);
                            root.drag-from = index;
                            root.drag-to = index;
                            root.drag-dy = 0;
                        }
                        drag-move(dy) => {
                            if (root.drag-from == index) {
                                root.drag-dy += dy;
                                root.drag-to = clamp(index + round(root.drag-dy / root.row-step), item.group-first, item.group-last);
                            }
                        }
                        drag-end => {
                            if (root.drag-from == index && root.drag-to != index) {
                                SettingsModel.library-move(index, root.drag-to);
                            }
                            root.drag-from = -1;
                            root.drag-to = -1;
                            root.drag-dy = 0;
                        }
                    }
                }
            }

            SettingsSection {
                title: "Playback";

                SwitchRow {
                    title: "Resume where you left off";
                    description: "Folders can have their own setting, from the Resume button in Browse.";
                    on: SettingsModel.resume;
                    toggled(on) => { SettingsModel.set-resume(on); }
                }

                Divider { }

                SwitchRow {
                    title: "Play the next file automatically";
                    description: "When a file ends, the next one in its folder starts, with an Up next card first.";
                    on: SettingsModel.auto-next;
                    toggled(on) => { SettingsModel.set-auto-next(on); }
                }

                Divider { }

                VerticalLayout {
                    padding-top: Theme.space-12;
                    padding-bottom: Theme.space-8;
                    spacing: Theme.space-12;

                    HorizontalLayout {
                        padding-left: Theme.space-20;
                        padding-right: Theme.space-20;

                        RowText {
                            title: "Mark as watched";
                            description: SettingsModel.watched-summary + (SettingsModel.watched-mode != 0 ? ". Time left waits until at most a quarter of the file is left" : "") + ". Playing to the end always counts.";
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-20;
                        padding-right: Theme.space-20;
                        alignment: root.narrow ? stretch : start;

                        TextSegments {
                            segments: root.narrow ? ["Percent", "Time left", "First of"] : ["Percentage", "Time left", "Whichever first"];
                            selected: SettingsModel.watched-mode;
                            select(i) => { SettingsModel.set-watched-mode(i); }
                        }
                    }

                    if SettingsModel.watched-mode != 1: StepperRow {
                        title: "Played";
                        value: SettingsModel.watched-percent;
                        can-down: SettingsModel.percent-down;
                        can-up: SettingsModel.percent-up;
                        step(d) => { SettingsModel.step-percent(d); }
                    }

                    if SettingsModel.watched-mode != 0: StepperRow {
                        title: "Time left";
                        value: SettingsModel.watched-remaining;
                        can-down: SettingsModel.remaining-down;
                        can-up: SettingsModel.remaining-up;
                        step(d) => { SettingsModel.step-remaining(d); }
                    }
                }
            }

            SettingsSection {
                title: "Folder settings";

                if SettingsModel.overrides.length == 0: HorizontalLayout {
                    padding: Theme.space-20;

                    Text {
                        text: "No folder has its own settings. Set them from the Resume button while browsing a folder.";
                        color: Theme.text-muted;
                        font-size: Theme.meta-size;
                        wrap: word-wrap;
                    }
                }

                for item[index] in SettingsModel.overrides: VerticalLayout {
                    if index > 0: Divider { }

                    HorizontalLayout {
                        padding-left: Theme.space-20;
                        padding-right: Theme.space-20;
                        padding-top: Theme.space-12;
                        padding-bottom: Theme.space-12;
                        spacing: Theme.space-16;

                        RowText {
                            title: item.folder;
                            description: item.detail;
                        }

                        VerticalLayout {
                            alignment: center;

                            PillButton {
                                text: "Clear";
                                accessible-name: "Clear settings for " + item.folder;
                                clicked => { SettingsModel.clear-override(index); }
                            }
                        }
                    }
                }
            }

            SettingsSection {
                title: "Thumbnails";

                SwitchRow {
                    title: "Thumbnails for network shares";
                    description: "Making one reads part of each file, which can be slow over a network.";
                    on: SettingsModel.network-thumbnails;
                    toggled(on) => { SettingsModel.set-network-thumbnails(on); }
                }
            }

            SettingsSection {
                title: "About";

                VerticalLayout {
                    padding: Theme.space-20;
                    spacing: Theme.space-8;

                    Text {
                        text: "Enthuse " + SettingsModel.version;
                        color: Theme.text;
                        font-size: Theme.body-size;
                        font-weight: Theme.body-strong-weight;
                    }

                    Text {
                        text: "Free software under the GNU General Public License, version 3 (GPL-3.0).";
                        color: Theme.text-muted;
                        font-size: Theme.meta-size;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Not affiliated with Firecore or Infuse.";
                        color: Theme.text-muted;
                        font-size: Theme.meta-size;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
